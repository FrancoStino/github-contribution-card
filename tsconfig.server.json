{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node10",
    "outDir": "./dist",
    "rootDir": ".",
    "declaration": false,
    "paths": {
      "@*": ["./src*"],
      "themes": ["./themes"],
      "package": ["./package.json"]
    }
  },
  "include": ["api/main.ts", "src/**/*", "themes/**/*", "types/**/*"],
  "exclude": ["node_modules", "action", "output", "dist"]
}
