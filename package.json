{
  "name": "github-contribution-card",
  "version": "2.0.0",
  "description": "Generate SVG cards showing GitHub contribution statistics",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "tsx scripts/gen-demo.ts && esbuild src/server.ts --bundle --platform=node --format=cjs --outfile=server.js --loader:.html=text --loader:.css=text --loader:.script=text --footer:js=\"module.exports = app;\"",
    "build:action": "esbuild action/src/index.ts --bundle --platform=node --format=cjs --outfile=action/dist/index.js --tsconfig=tsconfig.action.json",
    "vercel-build": "rm -rf .vercel/output && bash scripts/vercel-build.sh",
    "start": "yarn build && node server.js",
    "dev": "tsx scripts/gen-demo.ts && tsx watch src/server.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FrancoStino/github-contribution-card.git"
  },
  "author": "FrancoStino",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/FrancoStino/github-contribution-card/issues"
  },
  "homepage": "https://github.com/FrancoStino/github-contribution-card#readme",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "axios": "^1.18.1",
    "compression": "^1.7.4",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "lodash": "^4.17.21",
    "lru-cache": "^11.5.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "esbuild": "^0.28.1",
    "eslint": "10.8.0",
    "prettier": "^3.9.6",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
