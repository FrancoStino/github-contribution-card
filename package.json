{
  "name": "github-contribution-card",
  "version": "1.1.1",
  "description": "Generate SVG cards showing GitHub contribution statistics",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "tsx scripts/gen-demo.ts && esbuild api/main.ts --bundle --platform=node --format=cjs --outfile=dist/bundle.js --packages=external --loader:.html=text --loader:.css=text --loader:.script=text --footer:js=\"module.exports = app;\"",
    "build:action": "tsc -p tsconfig.action.json && tsc-alias -p tsconfig.action.json",
    "vercel-build": "rm -rf dist && yarn build",
    "start": "yarn build && node dist/bundle.js",
    "dev": "tsx watch api/main.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FrancoStino/github-contribution-card.git"
  },
  "author": "FrancoStino",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/FrancoStino/github-contribution-card/issues"
  },
  "homepage": "https://github.com/FrancoStino/github-contribution-card#readme",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "axios": "^1.18.1",
    "compression": "^1.7.4",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "lodash": "^4.17.21",
    "lru-cache": "^11.5.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.0",
    "@vercel/node": "^5.8.23",
    "concurrently": "^10.0.3",
    "eslint": "10.6.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.5",
    "progress-webpack-plugin": "^1.0.16",
    "ts-loader": "^9.6.2",
    "tsc-alias": "^1.8.17",
    "tsconfig-paths-webpack-plugin": "^4.0.0",
    "webpack": "^5.108.4",
    "webpack-cli": "^7.2.1"
  }
}
